{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // tsup sets baseUrl when it builds the types, which TypeScript 6
    // deprecates (an error unless ignored).
    "ignoreDeprecations": "6.0",
    "rootDir": "src",
    "outDir": "dist",
    "jsx": "react-jsx"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.test.tsx"]
}
