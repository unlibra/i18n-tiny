{
  "name": "@i18n-tiny/next",
  "version": "2.0.0-beta.1",
  "type": "module",
  "description": "Type-safe i18n for Next.js with automatic type inference and zero dependencies, and a define() under 2KB in the browser",
  "keywords": [
    "nextjs",
    "next",
    "i18n",
    "internationalization",
    "react",
    "typescript",
    "app-router",
    "server-components",
    "rsc"
  ],
  "author": "unlibra",
  "license": "MIT",
  "homepage": "https://docs.unlibra.com/i18n-tiny/next/introduction",
  "repository": {
    "type": "git",
    "url": "https://github.com/unlibra/i18n-tiny.git",
    "directory": "packages/next"
  },
  "main": "./dist/index.react-client.js",
  "types": "./dist/index.react-client.d.ts",
  "exports": {
    ".": {
      "react-server": {
        "types": "./dist/index.react-server.d.ts",
        "default": "./dist/index.react-server.js"
      },
      "types": "./dist/index.react-client.d.ts",
      "default": "./dist/index.react-client.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./proxy": {
      "types": "./dist/proxy/index.d.ts",
      "default": "./dist/proxy/index.js"
    },
    "./router": {
      "types": "./dist/router/index.d.ts",
      "default": "./dist/router/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsup",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@i18n-tiny/core": "workspace:*",
    "@i18n-tiny/react": "workspace:*"
  },
  "peerDependencies": {
    "next": "^15.0.0 || ^16.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.4",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
