{
  "name": "@i18n-tiny/core",
  "version": "1.3.0",
  "type": "module",
  "description": "Framework-agnostic core utilities for i18n-tiny",
  "keywords": [
    "i18n",
    "internationalization",
    "typescript"
  ],
  "author": "unlibra",
  "license": "MIT",
  "homepage": "https://docs.unlibra.com/i18n-tiny/",
  "repository": {
    "type": "git",
    "url": "https://github.com/unlibra/i18n-tiny.git",
    "directory": "packages/core"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./router": {
      "import": {
        "types": "./dist/router/index.d.ts",
        "default": "./dist/router/index.js"
      },
      "require": {
        "types": "./dist/router/index.d.cts",
        "default": "./dist/router/index.cjs"
      }
    },
    "./middleware": {
      "import": {
        "types": "./dist/middleware/index.d.ts",
        "default": "./dist/middleware/index.js"
      },
      "require": {
        "types": "./dist/middleware/index.d.cts",
        "default": "./dist/middleware/index.cjs"
      }
    },
    "./internal": {
      "import": {
        "types": "./dist/internal/index.d.ts",
        "default": "./dist/internal/index.js"
      },
      "require": {
        "types": "./dist/internal/index.d.cts",
        "default": "./dist/internal/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
