{
  "name": "astro-i18n-tiny",
  "version": "2.0.0",
  "type": "module",
  "description": "Alias package for @i18n-tiny/astro - Type-safe i18n for Astro that ships no client JavaScript",
  "keywords": [
    "astro",
    "i18n",
    "internationalization",
    "typescript",
    "ssg",
    "ssr"
  ],
  "author": "unlibra",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/unlibra/i18n-tiny.git",
    "directory": "packages/aliases/astro-i18n-tiny"
  },
  "homepage": "https://docs.unlibra.com/i18n-tiny/astro/introduction",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./middleware": {
      "types": "./middleware.d.ts",
      "default": "./middleware.js"
    },
    "./router": {
      "types": "./router.d.ts",
      "default": "./router.js"
    },
    "./internal": {
      "types": "./internal.d.ts",
      "default": "./internal.js"
    },
    "./router/*": "./router/*",
    "./locals": {
      "types": "./locals.d.ts"
    }
  },
  "files": [
    "index.d.ts",
    "index.js",
    "internal.d.ts",
    "internal.js",
    "locals.d.ts",
    "middleware.d.ts",
    "middleware.js",
    "router",
    "router.d.ts",
    "router.js"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@i18n-tiny/astro": "2.0.0"
  },
  "peerDependencies": {
    "astro": "^6.0.0 || ^7.0.0"
  }
}
