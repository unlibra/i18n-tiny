{
  "name": "next-i18n-tiny",
  "version": "1.3.0",
  "type": "module",
  "description": "Alias package for @i18n-tiny/next - Type-safe i18n for Next.js in under 1KB",
  "keywords": [
    "nextjs",
    "next",
    "i18n",
    "internationalization",
    "react",
    "typescript",
    "app-router",
    "server-components",
    "rsc"
  ],
  "author": "unlibra",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/unlibra/i18n-tiny.git",
    "directory": "packages/aliases/next-i18n-tiny"
  },
  "homepage": "https://docs.unlibra.com/i18n-tiny/next/introduction",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "react-server": {
        "types": "./index.react-server.d.ts",
        "default": "./index.react-server.js"
      },
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./types": {
      "types": "./types.d.ts",
      "default": "./types.js"
    },
    "./proxy": {
      "types": "./proxy.d.ts",
      "default": "./proxy.js"
    },
    "./router": {
      "types": "./router.d.ts",
      "default": "./router.js"
    }
  },
  "files": [
    "index.d.ts",
    "index.js",
    "index.react-server.d.ts",
    "index.react-server.js",
    "proxy.d.ts",
    "proxy.js",
    "router.d.ts",
    "router.js",
    "types.d.ts",
    "types.js"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@i18n-tiny/next": "1.3.0"
  },
  "peerDependencies": {
    "next": "^15.0.0 || ^16.0.0",
    "react": "^18.0.0 || ^19.0.0"
  }
}
