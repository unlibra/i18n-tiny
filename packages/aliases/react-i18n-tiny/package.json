{
  "name": "react-i18n-tiny",
  "version": "2.0.0-beta.1",
  "type": "module",
  "description": "Alias package for @i18n-tiny/react - Type-safe i18n for React in under 2KB",
  "keywords": [
    "react",
    "i18n",
    "internationalization",
    "typescript",
    "hooks",
    "context"
  ],
  "author": "unlibra",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/unlibra/i18n-tiny.git",
    "directory": "packages/aliases/react-i18n-tiny"
  },
  "homepage": "https://docs.unlibra.com/i18n-tiny/react/introduction",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./internal": {
      "types": "./internal.d.ts",
      "default": "./internal.js"
    }
  },
  "files": [
    "index.d.ts",
    "index.js",
    "internal.d.ts",
    "internal.js"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@i18n-tiny/react": "2.0.0-beta.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  }
}
