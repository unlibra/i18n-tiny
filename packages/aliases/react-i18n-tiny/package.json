{
  "name": "react-i18n-tiny",
  "version": "1.3.0",
  "type": "module",
  "description": "Alias package for @i18n-tiny/react - Type-safe i18n for React in under 1KB",
  "keywords": [
    "react",
    "i18n",
    "internationalization",
    "typescript",
    "hooks",
    "context"
  ],
  "author": "unlibra",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/unlibra/i18n-tiny.git",
    "directory": "packages/aliases/react-i18n-tiny"
  },
  "homepage": "https://docs.unlibra.com/i18n-tiny/react/introduction",
  "main": "./index.cjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./internal": {
      "import": {
        "types": "./internal.d.ts",
        "default": "./internal.js"
      },
      "require": {
        "types": "./internal.d.cts",
        "default": "./internal.cjs"
      }
    }
  },
  "dependencies": {
    "@i18n-tiny/react": "1.3.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  }
}
