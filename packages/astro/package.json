{
  "name": "@i18n-tiny/astro",
  "version": "2.0.0",
  "type": "module",
  "description": "Type-safe i18n for Astro that ships no client JavaScript, with automatic type inference and zero dependencies",
  "keywords": [
    "astro",
    "i18n",
    "internationalization",
    "typescript",
    "ssg",
    "ssr"
  ],
  "author": "unlibra",
  "license": "MIT",
  "homepage": "https://docs.unlibra.com/i18n-tiny/astro/introduction",
  "repository": {
    "type": "git",
    "url": "https://github.com/unlibra/i18n-tiny.git",
    "directory": "packages/astro"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "default": "./dist/middleware.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "default": "./dist/router.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./router/*": "./src/router/*",
    "./locals": {
      "types": "./src/locals.d.ts"
    }
  },
  "files": [
    "dist",
    "src/router",
    "src/locals.d.ts"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsup",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@i18n-tiny/core": "workspace:*"
  },
  "peerDependencies": {
    "astro": "^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "astro": "^7.4.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
