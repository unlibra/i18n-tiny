---
/**
 * Localized Link component for Astro
 *
 * Takes the define() result as the `i18n` prop, and builds the link with
 * its config, as localizedPath() does: the default locale gets no prefix
 * unless prefixDefault is true. Without `locale`, the link is for the
 * locale of the current page, read from its params or, in the SSR rewrite
 * mode, from Astro.locals.locale. A page without a locale there is of the
 * default locale. The base of the site is added to the link, so href is a
 * path without the base and without a locale prefix.
 *
 * @example
 * ```astro
 * import Link from '@i18n-tiny/astro/router/Link.astro'
 * import { i18n } from '../i18n'
 *
 * // The link for the locale of the current page
 * <Link href="/about" i18n={i18n}>About</Link>
 *
 * // A link for a locale: the default locale gets no prefix
 * <Link href="/" locale="en" i18n={i18n}>English</Link>
 *
 * // The current page in another locale
 * <a href={i18n.alternatePath(Astro.url.pathname, 'en')}>English</a>
 *
 * // The path without a locale
 * <Link href="/" locale={false}>Top</Link>
 * ```
 */
import type { LinkProps } from '@i18n-tiny/astro/internal'
import { linkHref } from '@i18n-tiny/astro/internal'

type Props = LinkProps

const { href, locale, i18n, ...attrs } = Astro.props

const locals = Astro.locals as Record<string, unknown>

// The locale of the current page: from the route params, or from the locals
// in the SSR rewrite mode
const currentLocale = (Astro.params.locale as string | undefined) ||
  (locals.locale as string | undefined)

const localizedHref = linkHref({
  href,
  currentLocale,
  locale,
  i18n,
  base: import.meta.env.BASE_URL
})
---

<a href={localizedHref} {...attrs}>
  <slot />
</a>
