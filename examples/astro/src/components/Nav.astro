---
import Link from '@i18n-tiny/astro/router/Link.astro'
import { i18n } from '../i18n'
import type { Locale } from '../i18n'

interface Props {
  locale: Locale
}

const t = i18n.getTranslations(Astro.props.locale, 'nav')
---

<!-- Links for the locale of the current page -->
<nav style="margin-bottom: 2rem;">
  <Link href="/" i18n={i18n} style="margin-right: 1rem;">{t('home')}</Link>
  <Link href="/about" i18n={i18n} style="margin-right: 1rem;">{t('about')}</Link>
  <Link href="/lab/color" i18n={i18n}>{t('lab')}</Link>
</nav>
