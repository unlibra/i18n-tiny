---
import type { InferGetStaticPropsType } from 'astro'
import LanguageSwitcher from '../../components/LanguageSwitcher.astro'
import Nav from '../../components/Nav.astro'
import { i18n } from '../../i18n'

// / in Japanese (the default locale) and /en in English
export function getStaticPaths() {
  return i18n.getStaticPaths()
}
type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { locale } = Astro.props
const t = i18n.getTranslations(locale)
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <title>{t('common.title')}</title>
  </head>
  <body style="padding: 2rem; font-family: system-ui;">
    <Nav locale={locale} />

    <h1>{t('home.welcome')}</h1>
    <p>{t('common.description')}</p>
    <p>{t('common.currentLocale', { locale })}</p>

    <div style="margin-top: 1rem;">
      <h3>{t('home.greeting', { name: 'User' })}</h3>
    </div>

    <hr style="margin: 2rem 0;" />

    <LanguageSwitcher locale={locale} path="/" />
  </body>
</html>
