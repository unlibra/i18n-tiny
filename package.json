{
  "name": "i18n-tiny",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tiny, type-safe i18n libraries for modern frameworks",
  "author": "unlibra",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/unlibra/i18n-tiny.git"
  },
  "scripts": {
    "build": "pnpm -r build",
    "type-check": "pnpm -r type-check",
    "lint": "eslint packages/*/src",
    "lint:fix": "eslint packages/*/src --fix",
    "aliases": "node scripts/generate-aliases.mjs",
    "test": "pnpm -r test && pnpm test:scripts",
    "test:scripts": "node --test scripts/test/*.test.mjs",
    "check:packages": "node scripts/check-packages.mjs",
    "size": "size-limit",
    "test:watch": "pnpm --filter @i18n-tiny/next test:watch"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@types/eslint__js": "^8.42.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "publint": "^0.3.25",
    "size-limit": "^14.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "packageManager": "pnpm@12.15.0"
}
